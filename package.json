{
  "name": "job-hunter-server",
  "version": "1.0.0",
  "description": "Backend API Server for Job Tracking Website",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:status": "prisma migrate status",
    "prisma:diff": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script",
    "postman:sync": "tsx apiDocumentation/sync.ts",
    "secrets:push": "tsx src/scripts/syncSecrets.ts",
    "secrets:push:dev": "tsx src/scripts/syncSecrets.ts dev",
    "secrets:push:prod": "tsx src/scripts/syncSecrets.ts prod"
  },
  "keywords": [
    "job-tracker",
    "backend",
    "express",
    "typescript",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "prisma": "^5.20.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  }
}
