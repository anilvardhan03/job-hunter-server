{
  "name": "job-hunter-server",
  "version": "1.0.0",
  "description": "Backend API Server for Job Tracking Website",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "dev:edge": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "tsx src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:status": "prisma migrate status",
    "postman:sync": "tsx apiDocumentation/sync.ts",
    "seed:users": "tsx src/scripts/seedUsers.ts"
  },
  "keywords": [
    "job-tracker",
    "backend",
    "express",
    "typescript",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@neondatabase/serverless": "^0.9.5",
    "@prisma/adapter-neon": "^5.20.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "hono": "^4.13.12",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@types/ws": "^8.18.2",
    "prisma": "^5.20.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "wrangler": "^4.146.0"
  }
