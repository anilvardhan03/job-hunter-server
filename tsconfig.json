{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@prisma/client": [
        "node_modules/.prisma/client/index.d.ts",
        "node_modules/@prisma/client"
      ]
    }
  },
  "include": [
    "src/**/*",
    "apiDocumentation/**/*"
  ]
}
